<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="KeypadRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalculatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalculatorButton.Utility">
        <item name="android:backgroundTint">@color/utility</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalculatorButton.Operator">
        <item name="android:backgroundTint">@color/operator</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="CalculatorButton.Equals">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/surface</item>
    </style>
</resources>
